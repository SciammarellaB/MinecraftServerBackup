cd /home/the_admin/server/docker/mineserver

cat > .gitignore <<'EOF'
# Ignora tudo na raiz, exceto os itens liberados abaixo
/*
!/.gitignore
!/compose.yml
!/data/

# Dentro de data, permite apenas o mundo
/data/*
!/data/The_Game/

# Arquivos temporários que não precisam ser restaurados
/data/The_Game/session.lock
.DS_Store
EOF
